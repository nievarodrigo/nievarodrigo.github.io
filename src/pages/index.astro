---
import Layout from "@/layouts/Layout.astro";
import "@/styles/portfolio.css";

const projects = [
  {
    number: "01",
    type: "SaaS · Producto propio",
    title: "FiloDesk",
    description:
      "Una plataforma de gestión para barberías, peluquerías y centros de estética. Turnos, caja, ventas, gastos, stock, equipo y métricas en un solo lugar.",
    impact:
      "Producto end-to-end: estrategia, UX, arquitectura, pagos y operación.",
    stack: ["Next.js", "TypeScript", "Supabase", "Rebill", "Mercado Pago"],
    image: "/filodesk-preview.png",
    imageAlt: "Página principal de FiloDesk",
    live: "https://filodesk.app",
    accent: "gold",
  },
  {
    number: "02",
    type: "Realtime · Producto propio",
    title: "Juntadita",
    description:
      "Una web app de juegos en vivo para fiestas. Los invitados entran desde el celular y participan en trivia, bingo, votaciones y desafíos controlados por un host.",
    impact:
      "Experiencia multijugador, sincronización en tiempo real y pagos premium.",
    stack: ["Next.js", "Supabase Realtime", "TypeScript", "Framer Motion"],
    image: "/juntadita-preview.png",
    imageAlt: "Página principal de Juntadita",
    live: "https://michucumple.vercel.app",
    accent: "violet",
  },
  {
    number: "03",
    type: "Diseño web · Trabajo para clientes",
    title: "Identidades digitales",
    description:
      "Una colección de sitios a medida para marcas reales: Punto Café, Michelle Pastelería, Sol Pilates, Complejo MPM y N1EVA Studio.",
    impact: "Dirección visual, narrativa, frontend responsive y publicación.",
    stack: ["Estrategia", "Copy", "UI/UX", "HTML · CSS · JS", "Vercel"],
    image: "/puntocafe-preview.png",
    imageAlt: "Landing page de Punto Café",
    live: "https://puntocafe-nine.vercel.app",
    accent: "sand",
  },
  {
    number: "04",
    type: "Dirección visual · Trabajo para cliente",
    title: "N1EVA Studio",
    description:
      "Una página web para un productor musical y filmmaker: identidad visual, trabajos, servicios y contacto directo en una experiencia pensada para su marca.",
    impact:
      "Una presencia digital con personalidad propia, rápida y adaptable a cualquier pantalla.",
    stack: [
      "Estrategia",
      "Copy",
      "Diseño visual",
      "HTML · CSS · JS",
      "Responsive",
    ],
    image: "/n1eva-preview.png",
    imageAlt: "Página principal de N1EVA Studio",
    live: "https://n1eva.vercel.app",
    accent: "red",
  },
];

const engineeringProjects = [
  {
    status: "SAAS · PRODUCTO ACTIVO",
    title: "FiloDesk Core",
    description:
      "Arquitectura multi-tenant para gestionar turnos, caja, stock, equipos, permisos y pagos sin mezclar los datos de cada negocio.",
    stack: ["Next.js", "TypeScript", "Supabase", "RLS", "Pagos"],
    href: "https://filodesk.app",
    linkLabel: "Ver producto",
    mark: "SaaS",
  },
  {
    status: "REALTIME · PRODUCTO PROPIO",
    title: "Juntadita Realtime",
    description:
      "Sesiones multijugador sincronizadas para que un host controle juegos y todos los invitados participen desde su celular.",
    stack: ["Next.js", "TypeScript", "Supabase", "Realtime", "Framer Motion"],
    href: "https://michucumple.vercel.app",
    linkLabel: "Ver producto",
    mark: "RT",
  },
  {
    status: "FRONTEND · TRABAJO PUBLICADO",
    title: "Sistemas visuales",
    description:
      "Interfaces con una identidad distinta para bienestar, gastronomía, turismo y música, construidas para funcionar en cualquier pantalla.",
    stack: ["UI/UX", "HTML", "CSS", "JavaScript", "Responsive"],
    href: "#proyectos",
    linkLabel: "Ver selección",
    mark: "UI",
  },
];

const stackLogos = [
  { slug: "typescript", name: "TypeScript" },
  { slug: "nextdotjs", name: "Next.js" },
  { slug: "react", name: "React" },
  { slug: "supabase", name: "Supabase" },
  { slug: "postgresql", name: "PostgreSQL" },
  { slug: "python", name: "Python" },
  { slug: "tailwindcss", name: "Tailwind CSS" },
  { slug: "framer", name: "Framer Motion" },
  { slug: "vercel", name: "Vercel" },
  { slug: "git", name: "Git" },
];

const aboutFacts = [
  { label: "Base", value: "Buenos Aires, Argentina" },
  { label: "Formación", value: "Ing. Informática · UADE" },
  { label: "Certificaciones", value: "Google · Gen AI & Cloud" },
  { label: "Stack", value: "TypeScript · Next.js · PostgreSQL" },
];

const capabilities = [
  {
    number: "01",
    title: "Producto",
    text: "Convierto una necesidad difusa en una experiencia clara, usable y lista para validar.",
  },
  {
    number: "02",
    title: "Ingeniería",
    text: "Construyo frontends, APIs, datos, permisos, pagos y operaciones con foco en confiabilidad.",
  },
  {
    number: "03",
    title: "Lanzamiento",
    text: "Trabajo el mensaje, la conversión, el deploy y los detalles que hacen que un producto se sienta terminado.",
  },
];
---

<Layout
  title="Rodrigo Nieva — Software Engineer"
  description="Portfolio de Rodrigo Nieva: productos SaaS en producción, experiencias realtime, sistemas fullstack y automatizaciones con IA."
>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <div class="scroll-progress" aria-hidden="true" data-scroll-progress>
    <span></span>
  </div>

  <header class="portfolio-header" data-header>
    <div class="portfolio-shell header-inner">
      <a class="wordmark" href="#inicio" aria-label="Rodrigo Nieva, inicio">
        <span>RN</span><i></i>
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="#proyectos">Proyectos</a>
        <a href="#ingenieria">Ingeniería</a>
        <a href="#capacidades">Enfoque</a>
        <a href="#sobre-mi">Sobre mí</a>
      </nav>
      <a class="header-contact" href="mailto:nievarodrigo40@gmail.com"
        >Contacto <span>↗</span></a
      >
      <button
        class="mobile-menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-button
      >
        <span class="sr-only">Abrir menú</span><i></i><i></i>
      </button>
    </div>
    <nav
      class="mobile-nav"
      id="mobile-nav"
      aria-label="Navegación móvil"
      data-mobile-nav
    >
      <a href="#proyectos">Proyectos</a><a href="#capacidades">Enfoque</a><a
        href="#ingenieria">Ingeniería</a
      ><a href="#sobre-mi">Sobre mí</a><a
        href="mailto:nievarodrigo40@gmail.com">Contacto</a
      >
    </nav>
  </header>

  <main id="contenido">
    <section class="hero" id="inicio">
      <div class="hero-grid portfolio-shell">
        <div class="hero-copy">
          <p class="availability">
            <span></span>Portfolio · Rodrigo Nieva · Buenos Aires
          </p>
          <h1>
            Diseño, código<br />y productos<br /><em>en producción.</em>
          </h1>
          <p class="hero-lead">
            Estudiante de Ingeniería en Informática (UADE) y software engineer.
            Construyo y sostengo productos en producción: entiendo el problema,
            diseño la experiencia y escribo el código.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#proyectos"
              >Explorar proyectos <span>↓</span></a
            >
            <a class="button button-ghost" href="#capacidades"
              >Cómo trabajo <span>↓</span></a
            >
          </div>
        </div>

        <div class="hero-stage" aria-label="Resumen profesional">
          <div class="stage-orbit orbit-a" data-parallax="0.035"></div><div
            class="stage-orbit orbit-b"
            data-parallax="-0.055"
          >
          </div>
          <div class="stage-card stage-card-main" data-parallax="0.075">
            <span class="stage-kicker">Product builder</span>
            <strong>Diseño<br />+ Código<br />+ Negocio</strong>
            <i>Buenos Aires · AR</i>
          </div>
          <div class="stage-card stage-card-stat" data-parallax="-0.11">
            <strong>7</strong><span
              >casos seleccionados<br />entre producto e ingeniería</span
            >
          </div>
          <div class="stage-card stage-card-stack" data-parallax="0.12">
            <span>STACK ACTUAL</span><strong
              >TypeScript · Next.js<br />Supabase · PostgreSQL<br />Python ·
              APIs · IA</strong
            >
          </div>
          <span class="stage-note">PROBLEMA → BUILD → SHIP → LEARN</span>
        </div>
      </div>
      <div class="hero-marquee" aria-hidden="true">
        <div>
          <span>PRODUCTOS DIGITALES</span><i>✦</i><span
            >PRODUCT ENGINEERING</span
          ><i>✦</i><span>SISTEMAS FULLSTACK</span><i>✦</i><span
            >PRODUCTOS DIGITALES</span
          ><i>✦</i><span>AUTOMATIZACIONES CON IA</span>
        </div>
      </div>
    </section>

    <section
      class="projects section"
      id="proyectos"
      aria-labelledby="projects-title"
    >
      <div class="portfolio-shell section-heading" data-reveal>
        <p class="section-label">01 / Trabajo seleccionado</p>
        <div>
          <h2 id="projects-title">
            Trabajo<br /><em>seleccionado.</em>
          </h2><p>
            Productos propios y trabajos para clientes. En cada caso participé
            desde la definición del problema hasta la experiencia y el código.
          </p>
        </div>
      </div>

      <div class="project-list portfolio-shell">
        {
          projects.map((project, index) => (
            <a
              class={`project-card project-${project.accent}`}
              href={project.live}
              target="_blank"
              rel="noopener"
              data-reveal
              style={`--reveal-delay: ${index % 2 === 0 ? 0 : 80}ms`}
            >
              <div class="project-visual" data-image-parallax>
                <div class="browser-bar">
                  <>
                    <i />
                    <i />
                    <i />
                    <span>{new URL(project.live).hostname}</span>
                  </>
                </div>
                <img
                  src={project.image}
                  alt={project.imageAlt}
                  width="1440"
                  height="900"
                  loading="lazy"
                  decoding="async"
                />
                <div class="project-overlay">
                  <p>{project.description}</p>
                  <strong>{project.impact}</strong>
                  <ul
                    class="tag-list"
                    aria-label={`Tecnologías de ${project.title}`}
                  >
                    {project.stack.map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  <span class="project-overlay-link">
                    Ver proyecto en vivo <i>↗</i>
                  </span>
                </div>
              </div>
              <div class="project-copy">
                <div class="project-meta">
                  <>
                    <span>{project.number}</span>
                    <span>{project.type}</span>
                  </>
                </div>
                <h3>{project.title}</h3>
                <p class="project-stackline">{project.stack.join(" · ")}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="services section" aria-label="Stack actual">
      <div class="stack-ticker" data-reveal>
        <p class="stack-ticker-label">Stack actual</p>
        <div class="stack-ticker-viewport">
          <div class="stack-ticker-track">
            {
              [0, 1].map(pass =>
                stackLogos.map(logo => (
                  <span class="stack-logo" aria-hidden={pass === 1}>
                    <img
                      src={`https://cdn.simpleicons.org/${logo.slug}/f4f2ec`}
                      alt={pass === 0 ? logo.name : ""}
                      width="26"
                      height="26"
                      loading="lazy"
                    />
                    <i>{logo.name}</i>
                  </span>
                ))
              )
            }
          </div>
        </div>
      </div>
    </section>

    <section
      class="engineering section"
      id="ingenieria"
      aria-labelledby="engineering-title"
    >
      <div
        class="portfolio-shell section-heading engineering-heading"
        data-reveal
      >
        <p class="section-label">02 / Código abierto</p>
        <div>
          <h2 id="engineering-title">Sistemas por<br /><em>dentro.</em></h2>
          <p>
            Arquitectura, tiempo real y sistemas visuales. Lo importante no es
            exponer cada archivo: es mostrar las decisiones que sostienen el
            resultado.
          </p>
        </div>
      </div>
      <div class="engineering-grid portfolio-shell">
        {
          engineeringProjects.map((project, index) => (
            <article
              class="engineering-card"
              data-reveal
              style={`--reveal-delay: ${index * 90}ms`}
            >
              <div class="engineering-mark" aria-hidden="true">
                <>
                  <span>{project.mark}</span>
                  <i />
                </>
              </div>
              <p class="engineering-status">{project.status}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <ul
                class="tag-list"
                aria-label={`Tecnologías de ${project.title}`}
              >
                {project.stack.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
              <a
                href={project.href}
                target={project.href.startsWith("http") ? "_blank" : undefined}
                rel={project.href.startsWith("http") ? "noopener" : undefined}
              >
                {project.linkLabel} <span>↗</span>
              </a>
            </article>
          ))
        }
      </div>
      <div class="github-callout privacy-callout portfolio-shell" data-reveal>
        <div>
          <span class="section-label">Código con contexto</span><h3>
            Las decisiones también son parte del trabajo.
          </h3>
        </div>
        <p>
          El código de productos activos se mantiene privado. Acá muestro el
          problema, la arquitectura, las decisiones y la experiencia final.
        </p>
      </div>
    </section>

    <section
      class="capabilities section"
      id="capacidades"
      aria-labelledby="capabilities-title"
    >
      <div class="portfolio-shell capabilities-grid">
        <div class="capabilities-intro" data-reveal>
          <p class="section-label">03 / Mi enfoque</p>
          <h2 id="capabilities-title">
            Del problema<br />al producto.<br /><em>Con criterio.</em>
          </h2>
        </div>
        <div class="capability-list">
          {
            capabilities.map((item, index) => (
              <article data-reveal style={`--reveal-delay: ${index * 80}ms`}>
                <>
                  <span>{item.number}</span>
                  <div>
                    <>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </>
                  </div>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="about section" id="sobre-mi" aria-labelledby="about-title">
      <div class="portfolio-shell about-grid">
        <div
          class="about-badge"
          aria-hidden="true"
          data-reveal
          data-parallax="0.045"
        >
          <span>RN</span><i>PRODUCT<br />BUILDER</i>
        </div>
        <div class="about-copy" data-reveal>
          <p class="section-label">04 / Sobre mí</p>
          <h2 id="about-title">
            Construyo como ingeniero.<br /><em>Pienso como usuario.</em>
          </h2>
          <div class="about-columns">
            <p>
              Estudio Ingeniería en Informática en UADE y desarrollo productos
              propios desde Buenos Aires. Me interesa el punto donde la
              tecnología deja de ser código y empieza a resolver algo de verdad.
            </p>
            <p>
              Trabajo de punta a punta: entiendo el negocio, diseño la
              experiencia, construyo el sistema y lo llevo a producción. Uso IA
              como acelerador, sin delegar el criterio ni la calidad, y comparto
              en GitHub parte del proceso de lo que voy construyendo.
            </p>
          </div>
          <dl class="about-facts">
            {
              aboutFacts.map(fact => (
                <div class="about-fact">
                  <>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section class="contact" id="contacto" aria-labelledby="contact-title">
      <div class="portfolio-shell contact-inner" data-reveal>
        <p class="section-label">05 / Contacto</p>
        <h2 id="contact-title">
          Sigamos la<br /><em>conversación.</em>
        </h2>
        <p>
          Estoy abierto a sumarme a un equipo donde pueda seguir construyendo y
          aprendiendo. Escribime y te respondo.
        </p>
        <a class="contact-mail" href="mailto:nievarodrigo40@gmail.com"
          >nievarodrigo40@gmail.com <span>↗</span></a
        >
        <div class="contact-links">
          <a
            href="https://www.linkedin.com/in/rodrigonieva/"
            target="_blank"
            rel="noopener">LinkedIn ↗</a
          >
        </div>
      </div>
    </section>
  </main>

  <footer class="portfolio-footer">
    <div class="portfolio-shell">
      <span>© {new Date().getFullYear()} Rodrigo Nieva</span><span
        >Diseñado y desarrollado en Buenos Aires</span
      ><a href="#inicio">Volver arriba ↑</a>
    </div>
  </footer>

  <script>
    const header = document.querySelector("[data-header]");
    const menuButton = document.querySelector("[data-menu-button]");
    const mobileNav = document.querySelector("[data-mobile-nav]");
    const progress = document.querySelector<HTMLElement>(
      "[data-scroll-progress] span"
    );
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    const closeMenu = () => {
      menuButton?.setAttribute("aria-expanded", "false");
      mobileNav?.classList.remove("is-open");
      document.body.classList.remove("menu-open");
    };
    menuButton?.addEventListener("click", () => {
      const open = menuButton.getAttribute("aria-expanded") !== "true";
      menuButton.setAttribute("aria-expanded", String(open));
      mobileNav?.classList.toggle("is-open", open);
      document.body.classList.toggle("menu-open", open);
    });
    mobileNav
      ?.querySelectorAll("a")
      .forEach(link => link.addEventListener("click", closeMenu));

    const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
    if (reduceMotion) {
      revealItems.forEach(item => item.classList.add("is-visible"));
    } else {
      document.documentElement.classList.add("motion-ready");
      const revealObserver = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          });
        },
        { rootMargin: "0px 0px -10%", threshold: 0.12 }
      );
      revealItems.forEach(item => revealObserver.observe(item));
    }

    const sections = document.querySelectorAll<HTMLElement>("main section[id]");
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(
      '.desktop-nav a[href^="#"]'
    );
    const sectionObserver = new IntersectionObserver(
      entries => {
        const visible = entries
          .filter(entry => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        navLinks.forEach(link => {
          const active = link.hash === `#${visible.target.id}`;
          link.classList.toggle("is-active", active);
          if (active) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
      },
      { rootMargin: "-35% 0px -55%", threshold: [0, 0.2, 0.6] }
    );
    sections.forEach(section => sectionObserver.observe(section));

    const parallaxItems = reduceMotion
      ? []
      : [...document.querySelectorAll<HTMLElement>("[data-parallax]")];
    const imageParallaxItems = reduceMotion
      ? []
      : [...document.querySelectorAll<HTMLElement>("[data-image-parallax]")];
    let frameRequested = false;

    const updateScrollMotion = () => {
      const scrollable = document.documentElement.scrollHeight - innerHeight;
      const ratio = scrollable > 0 ? window.scrollY / scrollable : 0;
      progress?.style.setProperty("transform", `scaleX(${ratio})`);
      header?.classList.toggle("is-scrolled", window.scrollY > 40);

      parallaxItems.forEach(item => {
        const rect = item.getBoundingClientRect();
        if (rect.bottom < -200 || rect.top > innerHeight + 200) return;
        const speed = Number(item.dataset.parallax ?? 0);
        const distance = (rect.top + rect.height / 2 - innerHeight / 2) * speed;
        const limited = Math.max(-48, Math.min(48, distance));
        item.style.setProperty("--parallax-y", `${limited.toFixed(2)}px`);
      });

      imageParallaxItems.forEach(item => {
        const rect = item.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > innerHeight) return;
        const relative =
          (rect.top + rect.height / 2 - innerHeight / 2) / innerHeight;
        item.style.setProperty(
          "--image-y",
          `${Math.max(-18, Math.min(18, relative * -28)).toFixed(2)}px`
        );
      });
      frameRequested = false;
    };

    const requestScrollMotion = () => {
      if (frameRequested) return;
      frameRequested = true;
      requestAnimationFrame(updateScrollMotion);
    };
    window.addEventListener("scroll", requestScrollMotion, { passive: true });
    window.addEventListener("resize", requestScrollMotion, { passive: true });
    requestScrollMotion();

    if (window.location.hash) {
      document.fonts.ready.then(() => {
        const target = document.querySelector<HTMLElement>(
          window.location.hash
        );
        target?.scrollIntoView({ block: "start" });
        target
          ?.querySelectorAll<HTMLElement>("[data-reveal]")
          .forEach(item => item.classList.add("is-visible"));
        requestScrollMotion();
      });
    }
  </script>
</Layout>
