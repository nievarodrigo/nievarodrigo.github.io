---
import Layout from "@/layouts/Layout.astro";
import "@/styles/presencia-local.css";

const contactUrl =
  "https://wa.me/5491121564104?text=Hola%20Rodrigo%2C%20quiero%20consultarte%20por%20Presencia%20Local";

const cases = [
  {
    category: "Bienestar · Ramos Mejía",
    title: "Sol Pilates",
    text: "Una experiencia cálida que transforma interés en consultas directas por WhatsApp.",
    image: "/sol-pilates-preview.png",
    alt: "Sitio web de Sol Pilates",
    url: "https://solpilates.vercel.app",
    position: "top",
  },
  {
    category: "Pastelería · Rafael Castillo",
    title: "Michelle Pastelería",
    text: "Productos, zona de trabajo y pedidos presentados con una identidad tan cuidada como sus tortas.",
    image: "/michelle-preview.png",
    alt: "Sitio web de Michelle Pastelería",
    url: "https://michelle-pasteleria.vercel.app",
    position: "top",
  },
  {
    category: "Estudio creativo · Buenos Aires",
    title: "N1EVA Studio",
    text: "Servicios, trabajos e identidad visual reunidos en una presencia digital con personalidad propia.",
    image: "/n1eva-preview.png",
    alt: "Sitio web de N1EVA Studio",
    url: "https://n1eva.vercel.app",
    position: "center",
  },
];

const packages = [
  {
    name: "Inicio Local",
    price: "320.000",
    description: "Para dejar de depender solamente de las redes.",
    features: [
      "Landing a medida",
      "Diseño para celular y computadora",
      "Contacto directo por WhatsApp",
      "Base técnica para buscadores",
      "Publicación y puesta online",
    ],
  },
  {
    name: "Presencia Local",
    price: "520.000",
    description: "La opción completa para que te puedan encontrar y consultar.",
    features: [
      "Todo lo incluido en Inicio Local",
      "Estrategia de búsquedas de tu zona",
      "Perfil de Empresa de Google",
      "Search Console, sitemap y datos locales",
      "Medición de visitas y consultas",
    ],
    featured: true,
  },
  {
    name: "Crecimiento Local",
    price: "750.000",
    description: "Para negocios que quieren trabajar más zonas o servicios.",
    features: [
      "Todo lo incluido en Presencia Local",
      "Más páginas de servicios o ubicaciones",
      "Contenido orientado a búsquedas locales",
      "Estrategia de crecimiento inicial",
      "Prioridad de implementación",
    ],
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Presencia Local",
  description:
    "Diseño web, posicionamiento local y contacto directo para negocios de Buenos Aires.",
  provider: {
    "@type": "Person",
    name: "Rodrigo Nieva",
    url: "https://nievarodrigo.github.io",
  },
  areaServed: {
    "@type": "AdministrativeArea",
    name: "Buenos Aires, Argentina",
  },
};
---

<Layout
  title="Presencia Local — Sitios web para negocios | Rodrigo Nieva"
  description="Sitios web a medida, bases de Google local y contacto directo para que más personas encuentren tu negocio y te consulten."
  canonicalURL="https://nievarodrigo.github.io/presencia-local/"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />

  <a class="pl-skip" href="#contenido">Saltar al contenido</a>

  <header class="pl-header" data-pl-header>
    <div class="pl-shell pl-header__inner">
      <a
        class="pl-brand"
        href="/"
        aria-label="Volver al portfolio de Rodrigo Nieva"
      >
        <span>RN</span><i></i><small>Presencia Local</small>
      </a>
      <nav class="pl-nav" aria-label="Navegación de Presencia Local">
        <a href="#que-incluye">Qué incluye</a>
        <a href="#trabajos">Trabajos</a>
        <a href="#opciones">Opciones</a>
      </nav>
      <a
        class="pl-header__cta"
        href={contactUrl}
        target="_blank"
        rel="noopener"
      >
        Contame sobre tu negocio <span>↗</span>
      </a>
    </div>
  </header>

  <main id="contenido">
    <section class="pl-hero">
      <div class="pl-shell pl-hero__grid">
        <div class="pl-hero__copy">
          <p class="pl-eyebrow">
            <span></span> Sitios para negocios de Buenos Aires
          </p>
          <h1>Que te encuentren cuando buscan <em>lo que hacés.</em></h1>
          <p class="pl-hero__lead">
            Creo una presencia digital propia para que tu negocio no dependa
            solamente de Instagram: sitio web, bases para Google y un camino
            directo a la consulta.
          </p>
          <div class="pl-actions">
            <a
              class="pl-button pl-button--primary"
              href={contactUrl}
              target="_blank"
              rel="noopener"
            >
              Quiero una propuesta <span>↗</span>
            </a>
            <a class="pl-button pl-button--ghost" href="#trabajos">
              Ver trabajos <span>↓</span>
            </a>
          </div>
          <p class="pl-hero__note">
            Diseño a medida · Sin plantillas genéricas · Tu dominio queda a tu
            nombre
          </p>
        </div>

        <div class="pl-search-card" aria-label="Ejemplo de búsqueda local">
          <div class="pl-search-card__top">
            <span></span><span></span><span></span>
            <small>BÚSQUEDA LOCAL</small>
          </div>
          <div class="pl-search-field">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.8-3.8"
              ></path></svg
            >
            <span data-search-copy>pastelería en mi zona</span><i></i>
          </div>
          <div class="pl-result-card">
            <div class="pl-result-card__meta">
              <span>Tu negocio</span><b>ABIERTO</b>
            </div>
            <strong>Una propuesta clara, cerca de la persona que busca.</strong>
            <p>Servicios · Zona de trabajo · Fotos · Información útil</p>
            <button type="button" tabindex="-1"
              >Consultar por WhatsApp <span>↗</span></button
            >
          </div>
          <div class="pl-search-card__footer">
            <span><i>01</i> Te buscan</span><span><i>02</i> Te conocen</span
            ><span><i>03</i> Te consultan</span>
          </div>
        </div>
      </div>

      <div class="pl-trust-strip">
        <div class="pl-shell">
          <strong>Tu negocio. Tu dominio. Tus accesos.</strong>
          <span>Vos sos titular de todo desde el primer día.</span>
        </div>
      </div>
    </section>

    <section class="pl-section pl-problem" aria-labelledby="problema-title">
      <div class="pl-shell pl-problem__grid">
        <div>
          <p class="pl-label">01 / El problema</p>
          <h2 id="problema-title">
            Instagram muestra.<br /><em>Pero no alcanza.</em>
          </h2>
        </div>
        <div class="pl-problem__copy">
          <p class="pl-big-copy">
            Si alguien ya te sigue, tus redes funcionan. El desafío es llegar a
            quien todavía no te conoce y está buscando una solución cerca.
          </p>
          <div class="pl-comparison">
            <article>
              <span>Solo redes</span>
              <h3>Esperás que lleguen</h3>
              <p>
                Dependés del algoritmo, las recomendaciones y que alguien
                encuentre tu perfil.
              </p>
            </article>
            <article class="is-positive">
              <span>Presencia propia</span>
              <h3>Estás cuando buscan</h3>
              <p>
                Tu propuesta se entiende, tu zona queda clara y consultar es
                simple.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section
      class="pl-section pl-system"
      id="que-incluye"
      aria-labelledby="sistema-title"
    >
      <div class="pl-shell">
        <div class="pl-heading">
          <p class="pl-label">02 / La solución</p>
          <div>
            <h2 id="sistema-title">
              No es solo una página.<br /><em
                >Es un sistema para encontrarte.</em>
            </h2>
            <p>
              Todo conectado para que una búsqueda pueda convertirse en una
              conversación real.
            </p>
          </div>
        </div>

        <div class="pl-system__grid">
          <article>
            <span class="pl-step">01</span>
            <div class="pl-icon" aria-hidden="true">⌁</div>
            <h3>Un sitio que se siente tuyo</h3>
            <p>
              Diseño, textos y estructura pensados para tu identidad, tus
              servicios y tus clientes.
            </p>
            <small>DISEÑO + MENSAJE</small>
          </article>
          <article>
            <span class="pl-step">02</span>
            <div class="pl-icon" aria-hidden="true">⌕</div>
            <h3>Bases para búsquedas locales</h3>
            <p>
              Configuración técnica e información clara para ayudar a Google a
              entender qué hacés y dónde.
            </p>
            <small>GOOGLE + TU ZONA</small>
          </article>
          <article>
            <span class="pl-step">03</span>
            <div class="pl-icon" aria-hidden="true">↗</div>
            <h3>Consulta sin vueltas</h3>
            <p>
              Botones y llamados a la acción para que pasar de mirar a
              escribirte sea fácil.
            </p>
            <small>WEB → WHATSAPP</small>
          </article>
        </div>

        <p class="pl-honesty">
          <span>Importante</span> Nadie puede prometerte el primer puesto en Google.
          Sí puedo construir y optimizar una presencia sólida para aumentar tus posibilidades
          de aparecer.
        </p>
      </div>
    </section>

    <section
      class="pl-section pl-work"
      id="trabajos"
      aria-labelledby="trabajos-title"
    >
      <div class="pl-shell">
        <div class="pl-heading pl-heading--light">
          <p class="pl-label">03 / Trabajo real</p>
          <div>
            <h2 id="trabajos-title">
              Cada negocio,<br /><em>una identidad distinta.</em>
            </h2>
            <p>
              No adapto la misma plantilla. Diseño cada experiencia alrededor de
              lo que hace especial al negocio.
            </p>
          </div>
        </div>

        <div class="pl-cases">
          {
            cases.map((item, index) => (
              <a class="pl-case" href={item.url} target="_blank" rel="noopener">
                <div class="pl-case__visual">
                  <div class="pl-browser">
                    <>
                      <i />
                      <i />
                      <i />
                      <span>{new URL(item.url).hostname}</span>
                    </>
                  </div>
                  <img
                    src={item.image}
                    alt={item.alt}
                    style={`object-position: ${item.position}`}
                  />
                </div>
                <div class="pl-case__copy">
                  <span>
                    {String(index + 1).padStart(2, "0")} · {item.category}
                  </span>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                  <b>
                    Ver sitio <i>↗</i>
                  </b>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="pl-section pl-pricing"
      id="opciones"
      aria-labelledby="opciones-title"
    >
      <div class="pl-shell">
        <div class="pl-heading">
          <p class="pl-label">04 / Opciones</p>
          <div>
            <h2 id="opciones-title">
              Una inversión clara.<br /><em>Sin costos escondidos.</em>
            </h2>
            <p>
              Elegimos el alcance según el momento de tu negocio. Si necesitás
              menos, sacamos alcance; no calidad.
            </p>
          </div>
        </div>

        <div class="pl-pricing__grid">
          {
            packages.map(item => (
              <article
                class:list={["pl-price-card", { "is-featured": item.featured }]}
              >
                {item.featured && (
                  <span class="pl-price-card__badge">Más completo</span>
                )}
                <p>{item.name}</p>
                <div class="pl-price">
                  <>
                    <small>DESDE ARS</small>
                    <strong>${item.price}</strong>
                  </>
                </div>
                <span class="pl-price-card__desc">{item.description}</span>
                <ul>
                  {item.features.map(feature => (
                    <li>
                      <i>✓</i>
                      {feature}
                    </li>
                  ))}
                </ul>
                <a href={contactUrl} target="_blank" rel="noopener">
                  Consultar esta opción <span>↗</span>
                </a>
              </article>
            ))
          }
        </div>

        <div class="pl-terms">
          <span><b>50%</b> para comenzar</span>
          <span><b>50%</b> antes de publicar</span>
          <span><b>100%</b> del dominio a tu nombre</span>
        </div>
        <p class="pl-price-note">
          Valores orientativos en pesos argentinos. Presupuesto válido por 7
          días. Dominio, hosting comercial y soporte continuo se detallan por
          separado.
        </p>
      </div>
    </section>

    <section class="pl-section pl-process" aria-labelledby="proceso-title">
      <div class="pl-shell pl-process__grid">
        <div class="pl-process__intro">
          <p class="pl-label">05 / Cómo trabajamos</p>
          <h2 id="proceso-title">Simple, claro<br />y <em>acompañado.</em></h2>
          <p>
            No necesitás saber de tecnología. Yo traduzco tu negocio a una
            experiencia digital y te explico cada decisión.
          </p>
        </div>
        <ol>
          <li>
            <span>01</span><div>
              <h3>Conozco tu negocio</h3><p>
                Hablamos de tus clientes, servicios, zona y objetivos.
              </p>
            </div>
          </li>
          <li>
            <span>02</span><div>
              <h3>Definimos la propuesta</h3><p>
                Recibís alcance, tiempos, inversión y responsabilidades por
                escrito.
              </p>
            </div>
          </li>
          <li>
            <span>03</span><div>
              <h3>Diseño y construyo</h3><p>
                Preparo la experiencia, la revisamos y ajustamos lo necesario.
              </p>
            </div>
          </li>
          <li>
            <span>04</span><div>
              <h3>Publicamos y medimos</h3><p>
                Conectamos dominio, buscadores y canales de consulta.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="pl-section pl-faq" aria-labelledby="faq-title">
      <div class="pl-shell pl-faq__grid">
        <div>
          <p class="pl-label">06 / Preguntas frecuentes</p>
          <h2 id="faq-title">Antes de<br /><em>empezar.</em></h2>
        </div>
        <div class="pl-faq__list">
          <details open>
            <summary>¿Voy a aparecer primero en Google?<span>+</span></summary>
            <p>
              No sería serio prometerlo. El trabajo crea una base profesional y
              optimizada para aumentar las posibilidades de que te encuentren en
              búsquedas relevantes de tu zona.
            </p>
          </details>
          <details>
            <summary>¿El dominio queda a mi nombre?<span>+</span></summary>
            <p>
              Sí. Lo comprás desde tu propia cuenta y sos titular desde el
              primer día. Yo te acompaño en la elección y configuro la parte
              técnica sin pedirte contraseñas.
            </p>
          </details>
          <details>
            <summary>¿Cuánto tarda?<span>+</span></summary>
            <p>
              Una presencia inicial suele llevar entre 2 y 4 semanas desde que
              recibo el contenido. Proyectos con más páginas o estrategia
              requieren un cronograma específico.
            </p>
          </details>
          <details>
            <summary>¿Tengo que pagar mantenimiento?<span>+</span></summary>
            <p>
              No necesariamente. Podés elegir una renovación técnica anual o
              sumar soporte y crecimiento mensual si querés cambios, contenido y
              seguimiento continuo.
            </p>
          </details>
          <details>
            <summary>¿Reemplaza a Instagram?<span>+</span></summary>
            <p>
              No: lo complementa. Instagram muestra el día a día; tu web ordena
              la propuesta, fortalece tu presencia en buscadores y te da un
              espacio propio.
            </p>
          </details>
        </div>
      </div>
    </section>

    <section class="pl-final">
      <div class="pl-shell pl-final__inner">
        <p class="pl-label">Tu próximo paso</p>
        <h2>
          Tu negocio ya tiene algo valioso.<br /><em
            >Hagamos que sea más fácil encontrarlo.</em>
        </h2>
        <p>
          Contame qué hacés y en qué zona trabajás. Te respondo con una
          recomendación concreta, sin compromiso.
        </p>
        <a
          class="pl-button pl-button--primary"
          href={contactUrl}
          target="_blank"
          rel="noopener">Hablar con Rodrigo <span>↗</span></a
        >
      </div>
    </section>
  </main>

  <footer class="pl-footer">
    <div class="pl-shell">
      <a class="pl-brand" href="/"
        ><span>RN</span><i></i><small>Presencia Local</small></a
      >
      <p>Diseñado y desarrollado en Buenos Aires.</p>
      <div>
        <a href="/">Portfolio</a><a href="mailto:nievarodrigo40@gmail.com"
          >Email</a
        ><a href={contactUrl} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
  </footer>

  <script>
    const header = document.querySelector("[data-pl-header]");
    window.addEventListener(
      "scroll",
      () => header?.classList.toggle("is-scrolled", window.scrollY > 24),
      { passive: true }
    );

    const searches = [
      "pastelería en mi zona",
      "pilates cerca mío",
      "estudio creativo en Buenos Aires",
    ];
    const searchCopy = document.querySelector("[data-search-copy]");
    let searchIndex = 0;
    if (
      searchCopy &&
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      window.setInterval(() => {
        searchIndex = (searchIndex + 1) % searches.length;
        searchCopy.classList.add("is-changing");
        window.setTimeout(() => {
          searchCopy.textContent = searches[searchIndex];
          searchCopy.classList.remove("is-changing");
        }, 180);
      }, 3200);
    }
  </script>
</Layout>
